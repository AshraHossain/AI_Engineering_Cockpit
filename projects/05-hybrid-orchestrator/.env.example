# Copy this file to .env and fill in your values. Never commit .env.

# --- Cloud (used everywhere) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local (Mac only; Ollama has no native Windows service in this setup) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Prompts longer than this many characters are routed to the cloud model
# even when Ollama is available, on the assumption that longer/complex
# prompts benefit more from a larger cloud model.
HYBRID_LOCAL_MAX_PROMPT_CHARS=400

LOG_LEVEL=INFO
