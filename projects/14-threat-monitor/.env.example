# Copy this file to .env if you want to override defaults. Never commit .env.
# No API key is needed: this project reads a local event stream and runs the
# cockpit Tier 3 detectors entirely offline. `--dry-run` and the tests need
# nothing from here at all.

# Logging verbosity for the CLI's own diagnostics (the report itself always
# goes to stdout regardless).
LOG_LEVEL=WARNING
