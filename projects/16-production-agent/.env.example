# Copy this file to .env and fill in what you use. Never commit .env.
#
# Nothing here is needed for `--dry-run`, which plays a scripted scenario and
# makes no network calls.

# Live mode: the Claude API.
ANTHROPIC_API_KEY=

# Live mode, optional: your support API. Leave SUPPORT_API_URL empty to use the
# built-in sample data. See "Connect your support API" in README.md.
SUPPORT_API_URL=
SUPPORT_API_TOKEN=

# Optional: Slack incoming webhook for src/slack_alerts.py.
SLACK_WEBHOOK_URL=
