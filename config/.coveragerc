; Coverage scope for the Tier 1 80% gate (see config/pytest.ini's --cov-fail-under).
;
; Tier 2/3 frameworks (evaluation, red_teaming, monitoring, governance) and the
; Tier 3 security modules (data_security, access_control, audit_logging,
; compliance, threat_detection) are intentionally unimplemented skeletons --
; every function raises NotImplementedError until that tier is built. Counting
; them against the coverage gate would either force writing throwaway
; NotImplementedError-assertion tests with no real signal, or force lowering
; the gate for code that has no logic to test yet. Omit them instead.
;
; cockpit/testing/* is itself testing infrastructure/example code (fixtures,
; demo unit/integration/benchmark tests), not application logic -- also omitted.
[run]
omit =
    cockpit/evaluation/*
    cockpit/red_teaming/*
    cockpit/monitoring/*
    cockpit/governance/*
    cockpit/security/data_security.py
    cockpit/security/access_control.py
    cockpit/security/audit_logging.py
    cockpit/security/compliance.py
    cockpit/security/threat_detection.py
    cockpit/testing/*
