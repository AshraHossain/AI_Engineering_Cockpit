# Copy this file to .env and fill in your keys. Never commit .env.

# --- Cloud model providers ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local models (Mac only; ignored on Windows) ---
OLLAMA_HOST=http://localhost:11434

# --- Platform behavior ---
# startup | enterprise | research | safety_focused
COCKPIT_USE_CASE=enterprise
LOG_LEVEL=INFO
